	private boolean checkDataExists(String monthyr, String team) {
		boolean exists=false;
		Connection conn=null;
		PreparedStatement pstmt=null;
		ResultSet rs=null;
		
		try {
			conn= DBUtilityAuto.getReportDBConnection();
			String query=" select * from rostertable where UPPER(MONTHYEAR)=? and team=?";
			pstmt=conn.prepareStatement(query);
			pstmt.setString(1,monthyr.toUpperCase());
			pstmt.setString(2, team );
			rs=pstmt.executeQuery();
			exists=rs.next();
		}catch(Exception e) {
			e.printStackTrace();
		}finally {
			try {
			if(rs!= null) rs.close();
			if(pstmt != null) pstmt.close();
			if(conn != null) conn.close();
			} catch(SQLException e) {
				e.printStackTrace();
			}
		}
		return exists;
		
	}
	
